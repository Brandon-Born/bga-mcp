{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": ["semantic", "proof", "unrelated"]
          },
          "sources": {
            "oneOf": [
              {
                "enum": ["*", "scenarios"]
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^https://en\\.doc\\.boardgamearena\\.com/[^ ]+$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": ["role", "sources", "reason", "paths"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "generatedImports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "expression", "reason", "dependencies"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "required": ["schemaVersion", "groups"]
}
