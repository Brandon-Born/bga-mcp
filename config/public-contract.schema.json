{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Brandon-Born/bga-mcp/raw/main/config/public-contract.schema.json",
  "title": "bga-mcp retained public contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "packageVersion",
    "status",
    "policyDigest",
    "release",
    "tools",
    "resources",
    "resourceTemplates",
    "prompts",
    "schemas",
    "compatibility",
    "deprecations"
  ],
  "properties": {
    "$schema": { "const": "../public-contract.schema.json" },
    "schemaVersion": { "const": 1 },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": { "enum": ["candidate", "published"] },
    "releasedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "serverName",
        "entrypoint",
        "bin",
        "exports",
        "typesDigest",
        "protocolVersions",
        "transports"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "serverName": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "bin": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "exports": { "type": "object", "minProperties": 1 },
        "typesDigest": { "$ref": "#/$defs/digest" },
        "protocolVersions": { "$ref": "#/$defs/names" },
        "transports": { "$ref": "#/$defs/names" }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "metadataDigest",
          "inputSchemaDigest",
          "outputSchemaDigest",
          "manifest"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "metadataDigest": { "$ref": "#/$defs/digest" },
          "inputSchemaDigest": { "$ref": "#/$defs/digest" },
          "outputSchemaDigest": { "$ref": "#/$defs/digest" },
          "manifest": { "$ref": "#/$defs/manifest" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "descriptorDigest", "manifest"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "descriptorDigest": { "$ref": "#/$defs/digest" },
          "manifest": { "$ref": "#/$defs/manifest" }
        }
      }
    },
    "resourceTemplates": { "$ref": "#/$defs/names" },
    "prompts": { "$ref": "#/$defs/names" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "compatibility", "contractVersion", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "compatibility": { "enum": ["package-major", "schema-version"] },
          "contractVersion": { "type": ["integer", "null"], "minimum": 1 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "value", "support"],
        "properties": {
          "id": { "type": "string", "pattern": "^CLAIM-" },
          "dimension": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "support": { "enum": ["supported", "unsupported", "unknown"] }
        }
      }
    },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "announcedIn",
          "removeNotBeforeVersion",
          "removeNotBeforeDate",
          "replacement"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^(tool|resource|resource-template|prompt|schema|protocol|transport|compatibility):"
          },
          "announcedIn": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "removeNotBeforeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "removeNotBeforeDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "replacement": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "published" } }, "required": ["status"] },
      "then": {
        "properties": {
          "releasedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "required": ["releasedAt"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "candidate" } }, "required": ["status"] },
      "then": { "properties": { "releasedAt": false } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stability",
        "supportedLayouts",
        "environments",
        "protocolVersions",
        "liveStudioRequired",
        "boundary"
      ],
      "properties": {
        "stability": { "const": "verified" },
        "supportedLayouts": { "$ref": "#/$defs/names" },
        "environments": { "$ref": "#/$defs/names" },
        "protocolVersions": { "$ref": "#/$defs/names" },
        "liveStudioRequired": { "const": false },
        "boundary": { "const": "TB-LOCAL-FILESYSTEM" }
      }
    }
  }
}
