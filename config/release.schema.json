{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Brandon-Born/bga-mcp/raw/main/config/release.schema.json",
  "title": "bga-mcp first-release inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "status",
    "environment",
    "entrypoint",
    "protocolVersions",
    "transports",
    "capabilities",
    "adapters",
    "consumers",
    "requiredScenarios"
  ],
  "properties": {
    "$schema": { "const": "./release.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "const": "first-local-only" },
    "status": { "enum": ["implemented", "verified"] },
    "environment": { "const": "local" },
    "entrypoint": { "const": "dist/release-cli.js" },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "2025-11-25" }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "stdio" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "resources", "prompts"],
      "properties": {
        "tools": { "$ref": "#/$defs/names" },
        "resources": { "$ref": "#/$defs/names" },
        "prompts": { "$ref": "#/$defs/names" }
      }
    },
    "adapters": { "$ref": "#/$defs/names" },
    "consumers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "candidate-manifest",
          "mcp-discovery",
          "public-documentation",
          "security-review",
          "verification-evidence"
        ]
      }
    },
    "requiredScenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$" }
    }
  },
  "$defs": {
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
