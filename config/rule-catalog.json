      "automatable": true,
      "group": "action-contracts",
      "tool": "validate_action_contracts",
      "summary": "The client and the entry point disagree about an action argument.",
      "severity": "warning",
      "certainty": "likely",
      "implementation": "src/rules/action-contracts.ts",
      "sources": [
        {
          "kind": "official-documentation",
          "reference": "Main game logic: Game.php says \"The query param from the front request will be matched with the PHP variable of the same name\", and lists the magic parameters the framework fills instead of the client.",
          "url": "https://en.doc.boardgamearena.com/Main_game_logic:_Game.php"
        }
      ],
      "fixtures": {
        "valid": "tests/fixtures/projects/legacy",
        "failing": "tests/fixtures/projects/legacy-broken",
        "validModern": "tests/fixtures/projects/modern"
      },
      "scenarios": [
        "E2E-VALIDATE-ACTIONS-CLEAN",
        "E2E-VALIDATE-ACTIONS-SEEDED-DEFECTS",
        "E2E-VALIDATE-ACTIONS-STATE-CLASSES"
      ],
      "owner": "Brandon Born"
    },
    {
