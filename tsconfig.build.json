{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "dist", "coverage"]
}
